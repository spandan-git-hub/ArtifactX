# ArtifactX Environment Configuration (placeholders only - do NOT put production secrets here)

# Application
APP_NAME=ArtifactX
DEBUG=false
LOG_LEVEL=INFO

# Primary Database Configuration (PostgreSQL in production/staging, e.g. Neon)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/artifactx

# Test Database Configuration (defaults to in-memory SQLite if unset; local PostgreSQL for pg marker tests)
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Upload Limits (in bytes, default 256 MiB = 268435456 bytes; DEC-009)
# In-memory forensic processing requires approximately 2-3x file size in memory for decompression,
# deserialization, and page parsing. Adjust considering worker RAM and database storage plan limits.
MAX_UPLOAD_SIZE=268435456