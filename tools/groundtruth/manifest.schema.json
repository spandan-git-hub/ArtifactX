{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactX Dataset Manifest Schema",
  "type": "object",
  "required": [
    "dataset_id",
    "variant",
    "seed",
    "generator_version",
    "origin",
    "created_by_tool_versions",
    "files",
    "modelled_vs_observed"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^DS-[0-9]{2}$"
    },
    "variant": {
      "type": "string",
      "enum": ["dev", "holdout"]
    },
    "seed": {
      "type": "integer"
    },
    "generator_version": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": ["synthetic", "device_capture"]
    },
    "created_by_tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "whatsapp": {
      "type": ["object", "null"],
      "properties": {
        "contacts": { "type": "array" },
        "chats": { "type": "array" },
        "messages": { "type": "array" },
        "deletions": { "type": "array" },
        "edits": { "type": "array" }
      }
    },
    "telegram": {
      "type": ["object", "null"],
      "properties": {
        "users": { "type": "array" },
        "chats": { "type": "array" },
        "messages": { "type": "array" },
        "deletions": { "type": "array" },
        "edits": { "type": "array" },
        "blob_variants": { "type": "array" }
      }
    },
    "shared_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value_norm", "occurrences", "expected_link"],
        "properties": {
          "type": { "type": "string" },
          "value_norm": { "type": "string" },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["app", "location"],
              "properties": {
                "app": { "type": "string", "enum": ["whatsapp", "telegram"] },
                "location": { "type": "string" },
                "raw_value": { "type": "string" }
              }
            }
          },
          "expected_link": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "decoys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value_norm", "occurrences", "expected_link", "decoy_reason"],
        "properties": {
          "type": { "type": "string" },
          "value_norm": { "type": "string" },
          "occurrences": { "type": "array" },
          "expected_link": { "type": "boolean" },
          "decoy_reason": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "encryption": {
      "type": ["object", "null"]
    },
    "tamper_records": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["fixture_path", "original_sha256", "tampered_sha256", "flip_offset", "original_byte", "flipped_byte"],
        "properties": {
          "fixture_path": { "type": "string" },
          "original_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "tampered_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "flip_offset": { "type": "integer", "minimum": 0 },
          "original_byte": { "type": "integer", "minimum": 0, "maximum": 255 },
          "flipped_byte": { "type": "integer", "minimum": 0, "maximum": 255 },
          "description": { "type": "string" }
        }
      }
    },
    "modelled_vs_observed": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
